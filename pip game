import pygame
import random
import sys

# Initialize Pygame
pygame.init()

# Screen Dimensions
WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Gun Game: Weapon Progression")

# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 50, 50)
GREEN = (50, 255, 50)
YELLOW = (255, 255, 0)
CYAN = (0, 255, 255)
MAGENTA = (255, 0, 255)

clock = pygame.time.Clock()
font = pygame.font.SysFont("Arial", 24)
large_font = pygame.font.SysFont("Arial", 48)

# --- WEAPON TIERS ---
# Defines the stats for each gun tier: [Name, Color, Bullet Speed, Cooldown (ms), Required Score to Upgrade]
WEAPON_TIERS = [
    {"name": "Pistol", "color": YELLOW, "bullet_speed": 7, "cooldown": 400, "threshold": 5},
    {"name": "Shotgun", "color": MAGENTA, "bullet_speed": 9, "cooldown": 250, "threshold": 15},
    {"name": "Submachine Gun", "color": CYAN, "bullet_speed": 12, "cooldown": 120, "threshold": 30},
    {"name": "Laser Rifle", "color": GREEN, "bullet_speed": 18, "cooldown": 60, "threshold": float('inf')} 
]

class Player:
    def __init__(self):
        self.width = 40
        self.height = 40
        self.x = WIDTH // 2 - self.width // 2
        self.y = HEIGHT - 70
        self.speed = 6
        self.current_tier_index = 0
        self.last_shot_time = 0

    @property
    def tier(self):
        return WEAPON_TIERS[self.current_tier_index]

    def move(self, keys):
        if keys[pygame.K_LEFT] and self.x > 0:
            self.x -= self.speed
        if keys[pygame.K_RIGHT] and self.x < WIDTH - self.width:
            self.x += self.speed

    def check_upgrade(self, score):
        # Upgrade weapon if score passes the current tier's threshold
        if score >= self.tier["threshold"] and self.current_tier_index < len(WEAPON_TIERS) - 1:
            self.current_tier_index += 1
            return True
        return False

    def draw(self):
        # Draw player body
        pygame.draw.rect(screen, WHITE, (self.x, self.y, self.width, self.height))
        # Draw gun barrel colorcoded to current tier
        pygame.draw.rect(screen, self.tier["color"], (self.x + self.width//2 - 4, self.y - 12, 8, 12))


class Bullet:
    def __init__(self, x, y, speed, color):
        self.x = x
        self.y = y
        self.radius = 5
        self.speed = speed
        self.color = color

    def update(self):
        self.y -= self.speed

    def draw(self):
        pygame.draw.circle(screen, self.color, (self.x, self.y), self.radius)


class Target:
    def __init__(self):
        self.radius = random.randint(15, 25)
        self.x = random.randint(self.radius, WIDTH - self.radius)
        self.y = random.randint(-100, -20)
        self.speed = random.randint(2, 5)

    def update(self):
        self.y += self.speed

    def draw(self):
        pygame.draw.circle(screen, RED, (self.x, self.y), self.radius)


# --- GAME SETUP ---
player = Player()
bullets = []
targets = []
score = 0
game_over = False

# Spawn initial targets
for _ in range(5):
    targets.append(Target())

# --- MAIN GAME LOOP ---
while True:
    current_time = pygame.time.get_ticks()
    screen.fill(BLACK)

    # Event Handling
    for event in pygame.event.get_event_dict():
        if event.get("type") == pygame.QUIT:
            pygame.quit()
            sys.exit()

    if not game_over:
        # Input handling
        keys = pygame.key.get_pressed()
        player.move(keys)

        # Shooting logic (Hold SPACE to fire based on weapon cooldown)
        if keys[pygame.K_SPACE]:
            if current_time - player.last_shot_time > player.tier["cooldown"]:
                bullet_x = player.x + player.width // 2
                bullet_y = player.y - 12
                bullets.append(Bullet(bullet_x, bullet_y, player.tier["bullet_speed"], player.tier["color"]))
                player.last_shot_time = current_time

        # Update Bullets
        for bullet in bullets[:]:
            bullet.update()
            if bullet.y < 0:
                bullets.remove(bullet)

        # Update Targets
        for target in targets[:]:
            target.update()
            # If a target hits the bottom, you lose
            if target.y > HEIGHT + target.radius:
                game_over = True

        # Collision Detection (Bullet vs Target)
        for bullet in bullets[:]:
            for target in targets[:]:
                # Distance formula checking for circle overlap
                distance = ((bullet.x - target.x)**2 + (bullet.y - target.y)**2)**0.5
                if distance < (bullet.radius + target.radius):
                    score += 1
                    if bullet in bullets:
                        bullets.remove(bullet)
                    targets.remove(target)
                    targets.append(Target()) # Respawn new target
                    
                    # Check for gun upgrade
                    player.check_upgrade(score)

        # Draw Elements
        player.draw()
        for bullet in bullets:
            bullet.draw()
        for target in targets:
            target.draw()

        # UI Overlay
        score_text = font.render(f"Score: {score}", True, WHITE)
        weapon_text = font.render(f"Weapon: {player.tier['name']}", True, player.tier['color'])
        
        # Display next upgrade threshold
        next_thresh = player.tier['threshold']
        next_text_str = f"Next Tier at: {next_thresh}" if next_thresh != float('inf') else "MAX TIER REACHED"
        next_text = font.render(next_text_str, True, WHITE)

        screen.blit(score_text, (20, 20))
        screen.blit(weapon_text, (20, 50))
        screen.blit(next_text, (20, 80))

    else:
        # Game Over Screen
        go_text = large_font.render("GAME OVER", True, RED)
        final_score_text = font.render(f"Final Score: {score}", True, WHITE)
        screen.blit(go_text, (WIDTH // 2 - 120, HEIGHT // 2 - 50))
        screen.blit(final_score_text, (WIDTH // 2 - 60, HEIGHT // 2 + 20))

    pygame.display.flip()
    clock.tick(60)
